<% content_for :title, "AI Humanizer | Cohere Chatbot" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "ai_humanizer", "data-turbo-track": "reload" %>
<% end %>
<div class="app-shell" data-ai-humanizer data-humanize-url="<%= humanize_ai_humanizer_path %>">
    <header class="page-header">
      <div>
        <div class="title-row">
          <h1>AI Humanizer</h1>
          <span class="live-dot" aria-hidden="true"></span>
        </div>
        <p>Keep your ideas. Make the words feel like you.</p>
      </div>
      <button class="btn btn-secondary history-trigger" id="historyBtn" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 7v5l3 2"/></svg>
        Version history
      </button>
    </header>

    <main>
      <section class="control-bar card" aria-label="Humanizer controls">
        <div class="control-group">
          <label for="tone">Writing tone</label>
          <select id="tone">
            <option>Conversational</option>
            <option>Professional</option>
            <option>Academic</option>
            <option>Friendly</option>
            <option>Concise</option>
            <option>Persuasive</option>
          </select>
        </div>

        <div class="control-group">
          <label for="language">Language</label>
          <select id="language">
            <option>English (US)</option>
            <option>English (UK)</option>
            <option>Indonesian</option>
            <option>Spanish</option>
            <option>French</option>
            <option>German</option>
          </select>
        </div>

        <div class="control-group intensity-group">
          <label>Rewrite intensity</label>
          <div class="segmented" role="group" aria-label="Rewrite intensity">
            <button class="segment" data-intensity="light" type="button">Light</button>
            <button class="segment active" data-intensity="balanced" type="button">Balanced</button>
            <button class="segment" data-intensity="creative" type="button">Creative</button>
          </div>
        </div>

        <label class="switch-row" for="preserveMeaning">
          <span class="switch">
            <input id="preserveMeaning" type="checkbox" checked />
            <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
          </span>
          <span>Preserve meaning</span>
          <span class="info-icon" title="Keeps the original intent while changing wording." aria-label="Preserve meaning info">i</span>
        </label>
      </section>

      <section class="workspace-grid">
        <article class="editor-card card">
          <div class="card-header">
            <div>
              <h2>Your original text</h2>
            </div>
            <div class="header-actions">
              <button class="link-btn" id="pasteBtn" type="button">Paste text</button>
              <button class="icon-btn" id="uploadBtn" title="Load a local .txt file" aria-label="Load a local text file" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M5 13v6h14v-6"/></svg>
              </button>
              <button class="icon-btn" id="clearBtn" title="Clear text" aria-label="Clear text" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="m7 7 1 13h8l1-13"/><path d="M10 11v5M14 11v5"/></svg>
              </button>
              <input id="fileInput" type="file" accept=".txt,.md,text/plain,text/markdown" hidden />
            </div>
          </div>
          <div class="editor-wrap">
            <textarea id="originalText" spellcheck="true" aria-label="Original text input">In today's rapidly evolving digital landscape, effective collaboration is paramount to organizational success. Our platform leverages innovative technology to facilitate seamless communication and streamline workflows across distributed teams.

By providing a comprehensive suite of tools, we empower professionals to maximize productivity and achieve their strategic objectives. It is important to note that the implementation of these solutions can significantly enhance operational efficiency and foster a culture of continuous improvement.</textarea>
          </div>
          <div class="card-footer editor-footer">
            <span id="sourceStats">83 words · 606 characters</span>
            <span>5,000 word limit</span>
          </div>
          <div class="action-strip left-action-strip">
            <span class="credits" id="creditsText">5,000 word limit</span>
            <button class="btn btn-primary humanize-btn" id="humanizeBtn" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 3-2 7H5l6 3-2 8 2-5h7l-5-3 2-10Z"/></svg>
              Humanize text
            </button>
          </div>
        </article>

        <article class="editor-card card output-card" id="output-card">
          <div class="card-header">
            <div class="output-title">
              <h2>Humanized text</h2>
              <span class="status-pill" id="statusPill">Ready</span>
            </div>
            <button class="icon-btn menu-trigger" id="outputMenuBtn" title="More options" aria-label="More options" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
            </button>
            <div class="floating-menu" id="outputMenu" hidden>
              <button type="button" id="downloadBtn">Download .txt</button>
              <button type="button" id="resetOutputBtn">Reset output</button>
            </div>
          </div>
          <div class="editor-wrap output-wrap">
            <div id="outputText" class="output-text" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Humanized text"></div>
          </div>
          <div class="quality-note">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h4"/><path d="M17 17h-4"/></svg>
            Click anywhere to fine-tune your result.
          </div>
          <div class="card-footer editor-footer output-stats">
            <span id="outputStats">0 words · 0 characters</span>
            <button class="link-btn" id="highlightBtn" type="button">Highlights show key changes</button>
          </div>
          <div class="action-strip output-actions">
            <button class="link-btn regenerate-btn" id="regenerateBtn" type="button">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 0-14.3-4.9L4 9"/><path d="M4 5v4h4"/><path d="M4 12a8 8 0 0 0 14.3 4.9L20 15"/><path d="M20 19v-4h-4"/></svg>
              Try another version
            </button>
            <div class="right-actions">
              <button class="btn btn-secondary" id="copyBtn" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>
                Copy
              </button>
              <button class="btn btn-primary save-btn" id="saveBtn" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h12l2 2v14H5z"/><path d="M8 4v6h8V4"/><path d="M9 20v-5h6v5"/></svg>
                Save
              </button>
            </div>
          </div>
        </article>
      </section>

      <section class="insight-grid" aria-label="Humanization quality insights">
        <div class="insight-card card">
          <div class="insight-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></div>
          <div><span class="eyebrow">Readability</span><strong id="readabilityValue">Easy to read</strong><small id="readabilityDesc">Clearer sentences, less jargon</small></div>
        </div>
        <div class="insight-card card">
          <div class="insight-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6.5A3.5 3.5 0 0 1 8.5 3h7A3.5 3.5 0 0 1 19 6.5v5A3.5 3.5 0 0 1 15.5 15H11l-4 4v-4.5A3.5 3.5 0 0 1 3.5 11V6.5"/></svg></div>
          <div><span class="eyebrow">Tone</span><strong id="toneValue">Natural &amp; conversational</strong><small id="toneDesc">Warm, confident, and approachable</small></div>
        </div>
        <div class="insight-card card">
          <div class="insight-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 19 6v5c0 4.5-2.9 7.8-7 10-4.1-2.2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <div><span class="eyebrow">Meaning</span><strong id="meaningValue">Your message, preserved</strong><small id="meaningDesc">Core ideas stay true to your original</small></div>
        </div>
      </section>
    </main>

    <footer class="privacy-footer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7a5 5 0 0 1 10 0v3"/><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M12 14v2"/></svg>
      Your text is sent to Cohere to create the rewrite. Drafts and saved versions stay in this browser.
    </footer>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <div class="modal-backdrop" id="historyModal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="historyTitle">
      <div class="modal-header">
        <div>
          <span class="eyebrow">Workspace</span>
          <h2 id="historyTitle">Version history</h2>
        </div>
        <button class="icon-btn" id="closeHistoryBtn" aria-label="Close version history" type="button">×</button>
      </div>
      <div class="version-list" id="versionList"></div>
      <div class="modal-footer">
        <button class="btn btn-secondary" id="clearHistoryBtn" type="button">Clear history</button>
        <button class="btn btn-primary" id="closeHistoryFooterBtn" type="button">Done</button>
      </div>
    </div>
  </div>


