<% content_for :title, "Sound to Text | Cohere Chatbot" %>
<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "sound_to_text", "data-turbo-track": "reload" %>
<% end %>

<main class="app-shell sound-to-text-page" data-sound-to-text>
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <div><span class="eyebrow">WORKSPACE</span><strong>Sound to Text</strong></div>
    </div>
    <div class="topbar-actions">
      <%= link_to "All services", all_service_path, class: "button", data: { turbo: false } %>
      <button class="button button-primary top-action" id="newTranscriptionBtn" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        New transcription
      </button>
    </div>
  </header>

  <div class="page">
    <section class="hero">
      <div>
        <span class="section-kicker">AUDIO WORKSPACE</span>
        <h1>Sound to text</h1>
        <p>Every conversation, captured. Turn your audio into something useful.</p>
      </div>
      <span class="preview-badge">Interactive preview</span>
    </section>

    <section class="upload-card card" id="dropZone" tabindex="0" aria-label="Audio file selection area">
      <div class="file-identity">
        <div class="file-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 12h1m3-4v8m4-10v12m4-8v4m3-6v8" /></svg>
        </div>
        <div class="file-copy">
          <strong id="fileName">Sample meeting audio.mp3</strong>
          <span id="fileMeta">Demo file · 12.4 MB · Sample timeline 08:42</span>
        </div>
      </div>

      <div class="field-group">
        <label for="language">Audio language</label>
        <div class="select-wrap">
          <select id="language">
            <option>English (sample)</option><option>Indonesian</option><option>English (US)</option>
            <option>English (UK)</option><option>Spanish</option><option>Japanese</option>
          </select>
        </div>
      </div>

      <div class="field-group">
        <label for="speakers">Speakers</label>
        <div class="select-wrap">
          <select id="speakers">
            <option>Identify automatically</option><option>2 speakers</option><option>3 speakers</option>
            <option>4 speakers</option><option>Do not identify</option>
          </select>
        </div>
      </div>

      <span class="status-pill" id="transcriptionStatus"><span class="status-dot"></span>Demo transcript</span>
      <input id="fileInput" type="file" accept=".mp3,.wav,.m4a,.mp4,audio/*,video/mp4" hidden />
      <div class="drop-hint">
        Files stay in this browser preview. Transcription is not connected yet.
        <button class="text-button" id="browseBtn" type="button">Choose file</button>
      </div>
    </section>

    <section class="workspace-grid">
      <div class="main-column">
        <section class="player-card card" aria-label="Sample audio timeline controls">
          <div class="player-row">
            <button class="play-button" id="playBtn" type="button" aria-label="Play sample timeline">
              <svg id="playIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
              <svg id="pauseIcon" class="is-hidden" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
            </button>
            <div class="waveform-wrap" id="waveform" role="slider" aria-label="Sample timeline position" aria-valuemin="0" aria-valuemax="522" aria-valuenow="64" tabindex="0">
              <div class="waveform" aria-hidden="true"></div><div class="wave-progress" id="waveProgress"></div>
            </div>
            <span class="speed-control" id="speedControl">1×</span>
            <div class="player-menu">
              <button class="icon-button" id="volumeBtn" type="button" aria-label="Mute sample timeline">
                <svg id="volumeIcon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4zm13.5 3a4.5 4.5 0 0 0-2.1-3.8m2.1 9.6A6.8 6.8 0 0 0 20.5 12a6.8 6.8 0 0 0-3-5.8" /></svg>
              </button>
              <button class="icon-button" id="moreBtn" type="button" aria-label="Playback speed options" aria-expanded="false">•••</button>
              <div class="menu-popover" id="moreMenu">
                <button type="button" data-speed="0.75">0.75×</button><button type="button" data-speed="1">1×</button>
                <button type="button" data-speed="1.25">1.25×</button><button type="button" data-speed="1.5">1.5×</button>
                <button type="button" data-speed="2">2×</button>
              </div>
            </div>
          </div>
          <div class="player-bottom">
            <span><strong id="currentTime">01:04</strong> / 08:42 <span class="timeline-note">· Demo timeline</span></span>
            <div class="player-actions">
              <button class="small-action" id="syncBtn" type="button">Sync sample transcript</button>
              <button class="small-icon" id="muteLabelBtn" type="button" aria-label="Mute sample timeline">🔊</button>
              <button class="small-icon" id="downloadAudioBtn" type="button" aria-label="Download sample audio">⋯</button>
            </div>
          </div>
        </section>

        <section class="transcript-card card">
          <div class="card-toolbar">
            <div class="tabs" role="tablist" aria-label="Transcript view">
              <button class="tab is-active" id="transcriptTab" data-tab="transcript" type="button" role="tab" aria-selected="true" aria-controls="transcriptPanel">Transcript</button>
              <button class="tab" id="subtitlesTab" data-tab="subtitles" type="button" role="tab" aria-selected="false" aria-controls="subtitlesPanel">Subtitles</button>
            </div>
            <div class="toolbar-actions">
              <button class="toolbar-button" id="searchBtn" type="button" aria-expanded="false" aria-controls="searchRow">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" /></svg>Search
              </button>
              <button class="toolbar-button accent" id="editBtn" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3ZM13.5 7.5l3 3" /></svg><span id="editLabel">Edit transcript</span></button>
            </div>
          </div>

          <div class="search-row is-hidden" id="searchRow">
            <label class="search-field" for="transcriptSearch">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.3-4.3M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" /></svg>
              <input type="search" id="transcriptSearch" placeholder="Search sample transcript…" /><span id="searchCount" aria-live="polite"></span>
            </label>
          </div>

          <div class="tab-panel" id="transcriptPanel" role="tabpanel" aria-labelledby="transcriptTab">
            <article class="transcript-message" data-time="00:00">
              <div class="avatar">AM</div><div class="message-content"><div class="message-heading"><strong>Alex Morgan</strong><button class="timestamp" data-time="0" type="button">00:00</button></div>
                <p contenteditable="false">All right, let's talk about the spring launch. The direction is simple: make the campaign feel like a breath of fresh air.<br>Less polished studio, more real moments.</p>
              </div>
            </article>
            <article class="transcript-message" data-time="00:18">
              <div class="avatar">JL</div><div class="message-content"><div class="message-heading"><strong>Jamie Lee</strong><button class="timestamp" data-time="18" type="button">00:18</button></div>
                <p contenteditable="false">I love that. We could use the alpine imagery as the starting point. The cabin, that soft morning light—there's already a story there.</p>
              </div>
            </article>
            <article class="transcript-message" data-time="00:32">
              <div class="avatar">AM</div><div class="message-content"><div class="message-heading"><strong>Alex Morgan</strong><button class="timestamp" data-time="32" type="button">00:32</button></div>
                <p contenteditable="false">Exactly. Let's create four image options first, then turn our favorite into a short video. A gentle camera push, a little movement in the trees. Nothing too dramatic.</p>
              </div>
            </article>
            <article class="transcript-message" data-time="00:51">
              <div class="avatar">JL</div><div class="message-content"><div class="message-heading"><strong>Jamie Lee</strong><button class="timestamp" data-time="51" type="button">00:51</button></div>
                <p contenteditable="false">I'll put together the first image concepts by Thursday. Could you send over the final copy and the mood board today?</p>
              </div>
            </article>
            <article class="transcript-message highlight" data-time="01:04">
              <div class="avatar">AM</div><div class="message-content"><div class="message-heading"><strong>Alex Morgan</strong><button class="timestamp" data-time="64" type="button">01:04</button></div>
                <p contenteditable="false">Absolutely, I'll share both this afternoon. Let's aim to review the concepts on Friday, then we can move into animation next week.</p>
              </div>
            </article>
          </div>

          <div class="tab-panel is-hidden" id="subtitlesPanel" role="tabpanel" aria-labelledby="subtitlesTab" hidden>
            <div class="subtitle-preview">
              <div class="subtitle-line"><span>00:00:00,000 → 00:00:18,000</span><p>All right, let's talk about the spring launch.</p></div>
              <div class="subtitle-line"><span>00:00:18,000 → 00:00:32,000</span><p>I love that. We could use the alpine imagery as the starting point.</p></div>
              <div class="subtitle-line"><span>00:00:32,000 → 00:00:51,000</span><p>Exactly. Let's create four image options first, then turn our favorite into a short video.</p></div>
            </div>
          </div>
          <div class="transcript-footer"><span>Sample transcript · 2 demo speakers</span><button class="link-button" type="button" id="continueBtn">Continue reading ↓</button></div>
        </section>
      </div>

      <aside class="sidebar" aria-label="Sample meeting details">
        <section class="notes-card card">
          <div class="section-heading"><div><span class="section-kicker">SAMPLE MEETING NOTES</span><h2>Spring campaign: a fresh direction</h2></div><span class="ai-tag">DEMO SUMMARY</span></div>
          <p class="summary">Sample notes for this preview: the team aligned on a natural, outdoors-inspired campaign using alpine imagery and subtle motion.</p>
          <div class="divider"></div><h3>Key takeaways</h3>
          <ul class="takeaways"><li>Lead with real moments and soft morning light.</li><li>Create four image concepts before animating.</li><li>Review Friday; begin video work next week.</li></ul>
        </section>
        <section class="action-card card">
          <div class="action-title-row"><h2>Action items <span id="actionCount">· 2</span></h2><button class="icon-button" id="addActionBtn" type="button" aria-label="Add action item">＋</button></div>
          <div id="actionItems">
            <label class="task-row"><input type="checkbox"><span><strong>Share copy &amp; mood board</strong><small>Alex · Today</small></span></label>
            <label class="task-row"><input type="checkbox"><span><strong>Create first image concepts</strong><small>Jamie · Thursday</small></span></label>
          </div>
          <button class="export-button" id="exportBtn" type="button"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 19h14" /></svg>Export transcript TXT</button>
        </section>
      </aside>
    </section>

    <p class="connection-note"><strong>Preview mode.</strong> The transcript, summary, and playback timeline above are examples. Choosing a file only updates this page; an audio transcription provider is not connected.</p>
  </div>
</main>

<div class="modal-backdrop is-hidden" id="modal" hidden>
  <section class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <header class="modal-header"><div><span class="section-kicker">NEW TRANSCRIPTION</span><h2 id="modalTitle">Choose a recording</h2></div><button class="icon-button" id="closeModalBtn" type="button" aria-label="Close">×</button></header>
    <p>Selecting a file updates this local preview only. It will not be uploaded or transcribed.</p>
    <button class="upload-picker" id="modalBrowseBtn" type="button"><span class="upload-picker-icon">↑</span><strong>Select a file</strong><small>MP3, WAV, M4A or MP4 · browser preview only</small></button>
  </section>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
